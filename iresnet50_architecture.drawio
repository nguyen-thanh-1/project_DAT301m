        <!-- Stage 4 Block 3 -->
        <mxCell id="s4_b3_c1" value="3×3 Convolution (512)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1c40f;strokeColor=#d68910;fontSize=12;" vertex="1" parent="1">

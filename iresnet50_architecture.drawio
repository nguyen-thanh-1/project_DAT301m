        <mxCell id="e_dense_to_l2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="out_dense" target="out_l2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_l2_to_emb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="out_l2" target="out_final"><mxGeometry relative="1" as="geometry" /></mxCell>



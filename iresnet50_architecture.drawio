        <mxCell id="e_s4b2_to_b3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s4_b2_c2" target="s4_b3_c1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="914" /><mxPoint x="610" y="874" /></Array></mxGeometry></mxCell>


        <!-- ================= ARCFACE OUTPUT HEAD & NORMALIZATION ================= -->
        <mxCell id="out_flatten" value="Flatten + BN + Dropout(0.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82e0aa;strokeColor=#28b463;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
